# Copy this file to .env and fill in real values.

# --- Database (Render PostgreSQL in production) ---
# Local Postgres matches docker-compose.yml. For hosted Postgres use
# Neon/Supabase/Render connection strings here instead.
DATABASE_URL="postgresql://poker:poker@localhost:5432/poker"

# --- apps/server (Render game server) ---
PORT=4000
# Comma-separated list of allowed browser origins (Vercel URL in production).
CLIENT_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Default room configuration offered to room creators (per-room values are
# chosen by creators and clamped to sane ranges by the server).
INITIAL_COINS=1000
SMALL_BLIND=10
BIG_BLIND=20
TURN_TIME_SECONDS=20

# Idle rooms with nobody connected are deleted after this long (ms).
EMPTY_ROOM_TTL_MS=300000

# --- apps/web (Vercel frontend) ---
NEXT_PUBLIC_SERVER_URL="http://localhost:4000"
